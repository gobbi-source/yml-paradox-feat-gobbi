{
  "$schema": "vscode://schemas/color-theme",
  "name": "Feat Gobbi Theme",
  "type": "dark",
  "tokenColors": [
		
		{
			"scope": "comment.ymlp",
			"settings": {
				"foreground": "#6A9955"
			}
		},
		{
			"scope": [
				"string",
				"meta.embedded.assembly"
			],
			"settings": {
				"foreground": "#CE9178"
			}
		},
		{
			"scope": "string.tag",
			"settings": {
				"foreground": "#CE9178"
			}
		},
		{
			"scope": "string.value",
			"settings": {
				"foreground": "#CE9178"
			}
		},
		{
			"scope": "string.regexp",
			"settings": {
				"foreground": "#D16969"
			}
		},
		{
			"scope": [
				"variable.ymlp",
				"meta.definition.variable.name",
				"support.variable",
				"entity.name.variable",
				"constant.other.placeholder"
			],
			"settings": {
				"foreground": "#9CDCFE"
			}
		},
		{
			"scope": "string.quoted.double.yaml",
			"settings": {
				"foreground": "#D9D9D9"
			}
		},
		{
			"scope": [
				"bracket-command.stellaris.yml",
				"loc-key.stellaris.yml"
			],
			"settings": {
				"fontStyle": "underline bold"
			}
		},
		{
			"scope": "keyword.icon-code.stellaris.yml",
			"settings": {
				"foreground": "#C0B235",
				"fontStyle": "underline italic"
			}
		},
		{
			"scope": "keyword.color-code.w.stellaris.yml",
			"settings": {
				"foreground": "#DCDCDC",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "keyword.color-code.t.stellaris.yml",
			"settings": {
				"foreground": "#D9D9D9",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "keyword.color-code.lowercase_g.stellaris.yml",
			"settings": {
				"foreground": "#6D6D6D",
				"fontStyle": "bold"
			}
		},
		{
			"scope": "keyword.color-code.l.stellaris.yml",
