{
  "name": "yml-paradox",
  "displayName": "yml paradox highlighting without theme",
  "description": "yml support for paradox, in configuration set editor.semanticHighlighting.enabled",
  "publisher": "gobbibomb",
  "icon": "images/thumbnail.jpg",
  "version": "1.0.2",
  "engines": {
    "vscode": "^1.109.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
		"stellaris",
		"yaml",
		"yml",
		"modding",
		"paradox"
	],
  "contributes": {
    "languages": [{
      "id": "yamlp",
      "aliases": ["yaml paradox", "yamlp", "yml paradox"],
      "extensions": [".yml"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "yamlp",
      "scopeName": "source.stellaris.yml",
      "path": "./syntaxes/yamlp.tmLanguage.json"
    }],

    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
          "textMateRules": [
        {
          "scope": "keyword.icon-code.stellaris.yml",
          "settings": {
            "foreground": "#C0B235",
            "fontStyle": "underline italic"
          },
          "scope": [
            "bracket-command.stellaris.yml",
            "loc-key.stellaris.yml"
          ],
          "settings": {
            "fontStyle": "underline bold"
          }
        },
        {
          "scope": "keyword.icon-code.stellaris.yml",
          "settings": {
            "foreground": "#C0B235",
            "fontStyle": "underline italic"
          }
        },
        {
          "scope": "keyword.color-code.w.stellaris.yml",
          "settings": {
            "foreground": "#DCDCDC",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code.t.stellaris.yml",
          "settings": {
            "foreground": "#D9D9D9",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code.lowercase_g.stellaris.yml",
          "settings": {
            "foreground": "#6D6D6D",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code.l.stellaris.yml",
          "settings": {
            "foreground": "#9E8F75",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code.p.stellaris.yml",
          "settings": {
            "foreground": "#BF5E5E",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code.r.stellaris.yml",
          "settings": {
            "foreground": "#D2483B",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code.s.stellaris.yml",
          "settings": {
            "foreground": "#B07921",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code.h.stellaris.yml",
          "settings": {
            "foreground": "#D69123",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code.y.stellaris.yml",
          "settings": {
            "foreground": "#D2D62C",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code.g.stellaris.yml",
          "settings": {
            "foreground": "#23BF20",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code.v.stellaris.yml",
          "settings": {
            "foreground": "#417560",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code.e.stellaris.yml",
          "settings": {
            "foreground": "#73D9B0",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code.c.stellaris.yml",
          "settings": {
            "foreground": "#1CC5B1",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code.b.stellaris.yml",
          "settings": {
            "foreground": "#2B8ED9",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code.m.stellaris.yml",
          "settings": {
            "foreground": "#8B2DCB",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code._.stellaris.yml",
          "settings": {
            "foreground": "#D900D9",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code.lowercase_c.stellaris.yml",
          "settings": {
            "foreground": "#33B17C",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code.lowercase_v.stellaris.yml",
          "settings": {
            "foreground": "#76948A",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code.lowercase_d.stellaris.yml",
          "settings": {
            "foreground": "#D9BC68",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code.lowercase_r.stellaris.yml",
          "settings": {
            "foreground": "#8B6FD9",
            "fontStyle": "bold"
          }
        },
        {
          "scope": "keyword.color-code.lowercase_l.stellaris.yml",
          "settings": {
            "foreground": "#97C959",
            "fontStyle": "bold"
          }
        },
        {
          "scope": [ "variable.loc.ymlp" ],
          "settings": {
            "foreground": "#2b6bd9"
          }
        }
      ]
      }
    }
  },
  "repository": {
		"type": "git",
		"url": "https://github.com/gobbi-source/yml-paradox-feat-gobbi"
	}
}
